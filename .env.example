# Solvent AI Environment Configuration
# Copy this file to .env and fill in your API keys

# REQUIRED: Generate a secure secret (run: npm run generate-secret)
BACKEND_INTERNAL_SECRET=

# AI Providers (at least one required)
GROQ_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional: Search providers
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional: Image generation
FAL_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: Local models
OLLAMA_HOST=http://127.0.0.1:11434
ENABLE_OLLAMA=true

# Server config (defaults shown)
PORT=3001
CORS_ORIGIN=http://localhost:5173
DEFAULT_PROVIDER=groq
AI_PROVIDER_TIMEOUT_MS=120000
