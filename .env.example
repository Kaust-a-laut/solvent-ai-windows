# Solvent AI Environment Configuration
# Copy this file to .env and fill in your API keys

# REQUIRED: Generate a secure secret (run: npm run generate-secret)
BACKEND_INTERNAL_SECRET=

# AI Providers (at least one required)
GROQ_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional: Search providers
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Optional: Image generation
FAL_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: Local models
OLLAMA_HOST=http://127.0.0.1:11434
ENABLE_OLLAMA=true

# Server config (defaults shown)
PORT=3001
CORS_ORIGIN=http://localhost:5173
DEFAULT_PROVIDER=groq
AI_PROVIDER_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# Native Bridge (sidecar) — DO NOT SET THESE in your own .env
# These are injected automatically when nativeCopyManager spawns a child copy.
# ─────────────────────────────────────────────────────────────────────────────
# SOLVENT_SIDECAR=1               # Set automatically; causes bullMqPrefix to
#                                 # switch to "bull-sidecar" so the sidecar's
#                                 # queues don't collide with the host's.
# PORT=3002                       # Injected per-spawn by findFreePort.

# ─────────────────────────────────────────────────────────────────────────────
# Copy-project frontend (Vite inside WebContainer)
# ─────────────────────────────────────────────────────────────────────────────
# When you dogfood a project via Native Bridge, the copy's frontend needs to
# proxy API calls to the sidecar port (e.g. 3002), not the host backend (3001).
# Set this in the COPY PROJECT's .env (not here), matching the sidecar's
# actual port — shown in the Native chip's expanded panel:
#
#   VITE_BACKEND_URL=http://localhost:3002

# ─────────────────────────────────────────────────────────────────────────────
# Agent file-write approval
# ─────────────────────────────────────────────────────────────────────────────
# Every agent tool that creates a new file (write_file/create_file to a new
# path, move_file destination, apply_patch, image outputs) goes through an
# approval check. With AUTO_APPROVE=true they proceed; with false they are
# blocked with APPROVAL_REQUIRED (no approval UI exists yet).
AUTO_APPROVE=true
